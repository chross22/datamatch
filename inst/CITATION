citHeader(
  "Cite the package for the implementation. The data products a given run ",
  "fetches carry their own citations - see the References section of the ",
  "README, and each function's own help page."
)

bibentry(
  bibtype = "Manual",
  key     = "datamatch",
  # Taken from DESCRIPTION rather than repeated, because a title written out
  # here goes stale silently: this one still said "Fetch Copernicus Marine Data"
  # after the package had grown to serve four sources, and nothing failed.
  title   = paste0(meta$Package, ": ", meta$Title),
  author  = person("Camille", "Ross",
                   comment = c(ORCID = "0000-0002-1428-2294")),
  year    = format(Sys.Date(), "%Y"),
  note    = paste0("R package version ", meta$Version),
  url     = "https://github.com/chross22/datamatch"
)
